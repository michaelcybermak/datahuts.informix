# Point HOST/PORT at your ngrok TCP tunnel, e.g.:
#   ngrok tcp 9088
#   -> forwarding tcp://0.tcp.ngrok.io:xxxxx -> localhost:9088
INFORMIX_HOST=0.tcp.ngrok.io
INFORMIX_PORT=xxxxx
INFORMIX_SERVER=ol_informix1410
INFORMIX_DATABASE=your_database
INFORMIX_USER=readonly_service_account
INFORMIX_PASSWORD=changeme
# Optional: exact ODBC driver name as registered on this machine. Check via
# `Get-OdbcDriver -Platform 64-bit | Where-Object { $_.Name -match "Informix" }`
# on Windows - some CSDK installs register it with a "(64-bit)" suffix.
INFORMIX_DRIVER=IBM INFORMIX ODBC DRIVER
